<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f4f1eb"><title>Planer for students by Klauzner.G</title>
<style>
:root{--bg:#f4f1eb;--paper:#fffdf9;--ink:#343a37;--muted:#89918a;--line:#e8e4dc;--sage:#dce8dc;--sageD:#66816e;--lav:#e8e3f1;--peach:#f4e3d8;--blue:#e1ebf0;--yellow:#f4edcf}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 system-ui,-apple-system,Segoe UI,sans-serif}button,input,select{font:inherit}button{cursor:pointer}.app{max-width:1400px;margin:auto;padding:24px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;gap:12px}.brand{display:flex;gap:12px;align-items:center}.mark{width:43px;height:43px;border-radius:14px;background:var(--sage);display:grid;place-items:center;color:var(--sageD);font-size:22px}.brand b{font-size:16px}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:.12em;text-transform:uppercase}.actions{display:flex;gap:9px;align-items:center}.btn,.soft{border:0;border-radius:11px;padding:11px 15px;font-size:12px;font-weight:750}.btn{background:#718a77;color:white}.soft{background:var(--paper);border:1px solid var(--line);color:var(--ink)}.layout{display:grid;grid-template-columns:250px minmax(0,1fr);gap:20px}.panel,.main{background:var(--paper);border:1px solid var(--line);border-radius:18px;box-shadow:0 10px 30px #4942360b}.side{display:flex;flex-direction:column;gap:14px}.panel{padding:17px}.profile{display:flex;gap:11px;align-items:center}.avatar{width:42px;height:42px;border-radius:50%;background:var(--lav);display:grid;place-items:center;color:#81749e;font-weight:800}.profile small{display:block;color:var(--muted);font-size:11px}.sideTitle{font-size:10px;color:var(--muted);font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin-bottom:12px}.miniHead,.row{display:flex;justify-content:space-between;align-items:center}.miniHead button,.dateNav button{border:0;background:transparent;color:var(--muted);padding:4px 8px}.mini{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;text-align:center}.mini span{font-size:9px;color:var(--muted);padding:5px 0}.mini button{border:0;background:none;border-radius:8px;height:28px;font-size:10px}.mini button.dim{color:#c4c7c1}.mini button.sel{background:var(--sage);color:#49644e;font-weight:800}.mini button.dot:after{content:"";display:block;background:#b77d60;width:3px;height:3px;border-radius:50%;margin:auto}.line{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:9px 0;font-size:12px}.line span:last-child{color:var(--muted)}.bar{height:6px;border-radius:9px;background:#efeee8;overflow:hidden}.bar i{display:block;height:100%;background:#9cb69f}.hint{font-size:12px;color:#747d75;line-height:1.55}.main{padding:24px;min-width:0}.welcome{display:flex;justify-content:space-between;gap:12px;align-items:start}.eyebrow{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--sageD);font-weight:800}.welcome h1{font-size:27px;letter-spacing:-1px;margin:5px 0}.welcome p,.desc{font-size:12px;color:var(--muted);margin:0}.tabs{display:flex;background:#f4f2ed;padding:4px;border-radius:10px}.tabs button{border:0;background:none;color:var(--muted);font-size:11px;padding:8px 12px;border-radius:7px}.tabs button.active{background:white;color:var(--ink)}.dateRow{display:flex;justify-content:space-between;align-items:center;margin:22px 0 14px}.dateNav{display:flex;gap:5px}.dateNav button{border:1px solid var(--line);background:white;border-radius:8px}.week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px}.day{border:1px solid var(--line);border-radius:12px;overflow:hidden;min-width:0;background:#fffefa}.dayHead{text-align:center;padding:10px 3px;background:#faf9f5;border-bottom:1px solid var(--line);cursor:pointer}.dayHead small{display:block;color:var(--muted);font-size:9px;text-transform:uppercase}.dayHead b{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;margin-top:3px}.day.sel .dayHead b{background:var(--sage);color:#49644e}.events{padding:6px;min-height:190px;display:flex;flex-direction:column;gap:5px}.event{border:0;border-radius:8px;padding:7px;text-align:left;font-size:10px;line-height:1.3;overflow-wrap:anywhere}.event small{display:block;font-size:9px;opacity:.7}.sage{background:var(--sage);color:#4e6c55}.lav{background:var(--lav);color:#6f628d}.peach{background:var(--peach);color:#94664f}.blue{background:var(--blue);color:#587888}.yellow{background:var(--yellow);color:#81703d}.empty{font-size:10px;color:#c2c5bf;text-align:center;padding:25px 0}.dayView{display:none}.dayView.show{display:block}.taskRow{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:11px;padding:11px;margin:7px 0}.time{width:42px;color:var(--muted);font-size:11px}.check{width:19px;height:19px;border:1px solid #c8d2c7;background:white;border-radius:6px;color:white}.check.done{background:#8ba48e}.taskText{flex:1}.taskText b{font-size:12px;display:block}.taskText small{font-size:10px;color:var(--muted)}.completed b{text-decoration:line-through;color:#a6aaa4}.bottom{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}.tracker{border-radius:14px;padding:17px;border:1px solid var(--line)}.sleep{background:#f4f0f8}.move{background:#f1f6f0}.tracker h3{font-size:13px;margin:0 0 8px}.tracker p{font-size:11px;color:var(--muted);margin:0 0 12px}.metric{font-size:26px;font-weight:800}.metric small{font-size:10px;color:var(--muted);font-weight:400}.trackerBtns{display:flex;gap:7px;margin-top:12px;flex-wrap:wrap}.trackerBtns button{background:#ffffffaa;border:1px solid #ddd8e5;border-radius:8px;padding:7px 9px;font-size:10px}.move .trackerBtns button{border-color:#d6e2d4}.modal{display:none;position:fixed;inset:0;background:#30352f66;z-index:5;align-items:center;justify-content:center;padding:16px}.modal.open{display:flex}.dialog{background:var(--paper);width:min(430px,100%);padding:24px;border-radius:17px;position:relative}.dialog h2{margin:0 0 5px;font-size:20px}.dialog p{color:var(--muted);font-size:12px;margin:0 0 17px}.close{position:absolute;right:15px;top:10px;border:0;background:none;font-size:23px;color:var(--muted)}.form{display:grid;grid-template-columns:1fr 1fr;gap:11px}.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:10px;color:var(--muted);font-weight:800;text-transform:uppercase}.field input,.field select{width:100%;padding:10px;border:1px solid var(--line);background:#fffefa;border-radius:8px;color:var(--ink)}.form .btn{grid-column:1/-1}.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#39463c;color:white;padding:10px 15px;border-radius:9px;font-size:12px;opacity:0;transition:.2s}.toast.show{opacity:1}footer{text-align:center;color:#a1a69f;font-size:10px;padding:24px}
@media(max-width:950px){.layout{grid-template-columns:210px 1fr}.main{padding:17px}.week{gap:4px}.events{padding:4px}.event{font-size:9px}}
@media(max-width:720px){.app{padding:14px}.layout{grid-template-columns:1fr}.side{display:grid;grid-template-columns:1fr 1fr}.profilePanel,.miniPanel{grid-column:1/-1}.main{padding:15px}.weekWrap{overflow-x:auto}.week{min-width:650px}.welcome{display:block}.tabs{width:max-content;margin-top:12px}.bottom{grid-template-columns:1fr}.dateRow{margin-top:17px}}
@media(max-width:450px){.side{grid-template-columns:1fr}.profilePanel,.miniPanel{grid-column:auto}.brand b{font-size:13px}.mark{width:37px;height:37px}.top .soft{display:none}.welcome h1{font-size:23px}.form{grid-template-columns:1fr}.field.full{grid-column:auto}}
</style></head><body>
<div class="app">
<header class="top"><div class="brand"><div class="mark">✦</div><div><b>Planer for students</b><small>by Klauzner.G</small></div></div><div class="actions"><button class="soft" onclick="today()">Сегодня</button><button class="btn" onclick="newTask()">＋ Новая задача</button></div></header>
<div class="layout"><aside class="side">
<div class="panel profilePanel"><div class="profile"><div class="avatar">G</div><div><b>Мой планер</b><small>Маленькие шаги каждый день</small></div></div></div>
<div class="panel miniPanel"><div class="miniHead"><b id="monthLabel"></b><span><button onclick="month(-1)">‹</button><button onclick="month(1)">›</button></span></div><div class="mini" id="mini"></div></div>
<div class="panel"><div class="sideTitle">Фокус дня</div><div class="line"><span>Выполнено задач</span><span id="counts">0 / 0</span></div><div class="bar"><i id="taskBar" style="width:0%"></i></div><div class="line"><span>Запланировано</span><span id="hours">0 ч</span></div></div>
<div class="panel"><div class="sideTitle">Подсказка дня</div><div class="hint">Не обязательно успеть всё. Выбери одну главную задачу и начни с неё. Перерывы тоже часть хорошего плана.</div></div>
</aside>
<main class="main"><div class="welcome"><div><div class="eyebrow">Твоё пространство</div><h1 id="greeting">Хорошего дня!</h1><p>Планируй время, двигайся в своём ритме и отмечай прогресс.</p></div><div class="tabs"><button id="weekTab" class="active" onclick="view('week')">Неделя</button><button id="dayTab" onclick="view('day')">День</button></div></div>
<div class="dateRow"><b id="range"></b><div class="dateNav"><button onclick="shift(-1)">‹</button><button onclick="shift(1)">›</button></div></div>
<div class="weekWrap"><div class="week" id="week"></div></div><div class="dayView" id="dayView"></div>
<div class="bottom">
<div class="tracker sleep"><h3>🌙 Трекер сна</h3><p>Отмечай продолжительность отдыха и следи за режимом.</p><div class="metric"><span id="sleepValue">—</span> <small>часов сна</small></div><div class="bar"><i id="sleepBar" style="width:0%;background:#a99abe"></i></div><div class="trackerBtns"><button onclick="tracker('sleep')">＋ Записать сон</button><button onclick="history('sleep')">История за день</button></div></div>
<div class="tracker move"><h3>🏃 Физическая активность</h3><p>Любое движение имеет значение. Запиши свою активность.</p><div class="metric"><span id="moveValue">0</span> <small>минут сегодня</small></div><div class="bar"><i id="moveBar" style="width:0%;background:#8eaa91"></i></div><div class="trackerBtns"><button onclick="tracker('move')">＋ Добавить активность</button><button onclick="history('move')">История за день</button></div></div>
</div></main></div><footer>Planer for students by Klauzner.G · Твой день — твои правила</footer></div>
<div class="modal" id="taskModal"><div class="dialog"><button class="close" onclick="closeModal('taskModal')">×</button><h2 id="taskTitle">Новая задача</h2><p>Запланируй дело и освободи место для важного.</p><form class="form" id="taskForm">
<div class="field full"><label>Название задачи</label><input id="name" required maxlength="80" placeholder="Например, подготовиться к экзамену"></div>
<div class="field"><label>Дата</label><input id="date" type="date" required></div><div class="field"><label>Время</label><input id="time" type="time" value="09:00"></div>
<div class="field"><label>Категория</label><select id="category"><option value="sage">Учёба</option><option value="lav">Личное</option><option value="peach">Отдых</option><option value="blue">Здоровье</option><option value="yellow">Другое</option></select></div>
<div class="field"><label>Длительность</label><select id="duration"><option value="30">30 минут</option><option value="60" selected>1 час</option><option value="90">1,5 часа</option><option value="120">2 часа</option><option value="180">3 часа</option></select></div><button class="btn" type="submit">Сохранить задачу</button></form></div></div>
<div class="modal" id="trackModal"><div class="dialog"><button class="close" onclick="closeModal('trackModal')">×</button><h2 id="trackTitle">Трекер</h2><p id="trackDesc"></p><form class="form" id="trackForm">
<div class="field full" id="sleepFields"><label>Сколько спал(а), часов</label><input id="sleepHours" type="number" min="0" max="24" step=".25" placeholder="Например, 7.5"></div>
<div class="field full" id="moveFields" style="display:none"><label>Вид активности</label><select id="activityType"><option>Прогулка</option><option>Тренировка</option><option>Бег</option><option>Велосипед</option><option>Йога / растяжка</option><option>Другое</option></select><label>Продолжительность, минут</label><input id="activityMinutes" type="number" min="1" max="1440" placeholder="Например, 40"></div><button class="btn" type="submit">Сохранить</button></form></div></div><div class="toast" id="toast"></div>
<script>
const $=id=>document.getElementById(id),iso=d=>{let x=new Date(d);x.setMinutes(x.getMinutes()-x.getTimezoneOffset());return x.toISOString().slice(0,10)},parse=s=>{let [y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d)},fmt=(d,o={day:'numeric',month:'long'})=>new Intl.DateTimeFormat('ru-RU',o).format(d),names=['Пн','Вт','Ср','Чт','Пт','Сб','Вс'];
let now=new Date();now.setHours(0,0,0,0);let selected=new Date(now),offset=0,mode='week',editing=null,trackType='sleep';
let tasks=JSON.parse(localStorage.getItem('planer_tasks')||'[]'),sleeps=JSON.parse(localStorage.getItem('planer_sleep')||'{}'),moves=JSON.parse(localStorage.getItem('planer_moves')||'{}');
function save(){localStorage.setItem('planer_tasks',JSON.stringify(tasks));localStorage.setItem('planer_sleep',JSON.stringify(sleeps));localStorage.setItem('planer_moves',JSON.stringify(moves))}
function weekDates(){let s=new Date(selected);s.setDate(s.getDate()-(s.getDay()+6)%7+offset*7);return Array.from({length:7},(_,i)=>{let d=new Date(s);d.setDate(s.getDate()+i);return d})}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function render(){mini();drawWeek();drawTrackers();stats();$('greeting').textContent=iso(selected)===iso(now)?'Хорошего дня!':fmt(selected,{weekday:'long',day:'numeric',month:'long'});$('weekTab').classList.toggle('active',mode==='week');$('dayTab').classList.toggle('active',mode==='day');$('week').style.display=mode==='week'?'grid':'none';$('dayView').style.display=mode==='day'?'block':'none'}
function mini(){let y=selected.getFullYear(),m=selected.getMonth(),first=new Date(y,m,1),start=new Date(y,m,1-(first.getDay()+6)%7);$('monthLabel').textContent=fmt(first,{month:'long',year:'numeric'});let h=names.map(n=>`<span>${n}</span>`).join('');for(let i=0;i<42;i++){let d=new Date(start);d.setDate(start.getDate()+i);let k=iso(d);h+=`<button class="${d.getMonth()!==m?'dim ':''}${k===iso(selected)?'sel ':''}${tasks.some(t=>t.date===k)?'dot':''}" onclick="pick('${k}')">${d.getDate()}</button>`}$('mini').innerHTML=h}
function drawWeek(){let ds=weekDates();$('range').textContent=fmt(ds[0],{day:'numeric',month:'long'})+' — '+fmt(ds[6],{day:'numeric',month:'long',year:'numeric'});$('week').innerHTML=ds.map(d=>{let k=iso(d),list=tasks.filter(t=>t.date===k).sort((a,b)=>a.time.localeCompare(b.time));return `<div class="day ${k===iso(selected)?'sel':''}"><div class="dayHead" onclick="pick('${k}')"><small>${names[(d.getDay()+6)%7]}</small><b>${d.getDate()}</b></div><div class="events">${list.length?list.map(t=>`<button class="event ${t.category}" onclick="pick('${k}');edit('${t.id}')"><small>${t.time} ${t.done?'✓':''}</small>${esc(t.name)}</button>`).join(''):'<div class="empty">Свободно</div>'}</div></div>`}).join('');if(mode==='day')drawDay()}
function drawDay(){let list=tasks.filter(t=>t.date===iso(selected)).sort((a,b)=>a.time.localeCompare(b.time));$('dayView').innerHTML=list.length?list.map(t=>`<div class="taskRow ${t.done?'completed':''}"><span class="time">${t.time}</span><button class="check ${t.done?'done':''}" onclick="toggle('${t.id}')">${t.done?'✓':''}</button><div class="taskText"><b>${esc(t.name)}</b><small>${({sage:'Учёба',lav:'Личное',peach:'Отдых',blue:'Здоровье',yellow:'Другое'})[t.category]} · ${t.duration} мин</small></div><button class="soft" onclick="edit('${t.id}')">···</button></div>`).join(''):'<div class="empty">На этот день задач пока нет. Добавь первую задачу ✨</div>'}
function stats(){let a=tasks.filter(t=>t.date===iso(selected)),d=a.filter(t=>t.done).length;$('counts').textContent=`${d} / ${a.length}`;$('taskBar').style.width=(a.length?d/a.length*100:0)+'%';$('hours').textContent=(a.reduce((s,t)=>s+Number(t.duration),0)/60).toFixed(1)+' ч'}
function drawTrackers(){let k=iso(selected),mins=(moves[k]||[]).reduce((s,a)=>s+a.minutes,0);$('sleepValue').textContent=sleeps[k]??'—';$('sleepBar').style.width=Math.min(100,Number(sleeps[k]||0)/8*100)+'%';$('moveValue').textContent=mins;$('moveBar').style.width=Math.min(100,mins/60*100)+'%'}
function pick(k){selected=parse(k);offset=0;render()}function today(){selected=new Date(now);offset=0;render()}function month(n){selected.setMonth(selected.getMonth()+n);offset=0;render()}function shift(n){if(mode==='week')offset+=n;else selected.setDate(selected.getDate()+n);render()}function view(v){mode=v;render()}
function newTask(){editing=null;$('taskTitle').textContent='Новая задача';$('taskForm').reset();$('date').value=iso(selected);$('time').value='09:00';$('taskModal').classList.add('open')}
function edit(id){let t=tasks.find(x=>x.id===id);if(!t)return;editing=id;$('taskTitle').textContent='Изменить задачу';$('name').value=t.name;$('date').value=t.date;$('time').value=t.time;$('category').value=t.category;$('duration').value=t.duration;$('taskModal').classList.add('open')}
function toggle(id){let t=tasks.find(x=>x.id===id);t.done=!t.done;save();render();toast(t.done?'Задача выполнена ✓':'Отметка снята')}
$('taskForm').onsubmit=e=>{e.preventDefault();let t={id:editing||String(Date.now()),name:$('name').value.trim(),date:$('date').value,time:$('time').value||'09:00',category:$('category').value,duration:+$('duration').value,done:false};if(editing){t.done=tasks.find(x=>x.id===editing)?.done||false;tasks=tasks.map(x=>x.id===editing?t:x)}else tasks.push(t);selected=parse(t.date);offset=0;save();closeModal('taskModal');render();toast('Задача сохранена')};
function tracker(type){trackType=type;$('trackTitle').textContent=type==='sleep'?'Записать сон':'Добавить активность';$('trackDesc').textContent='Данные за '+fmt(selected,{day:'numeric',month:'long'});$('sleepFields').style.display=type==='sleep'?'flex':'none';$('moveFields').style.display=type==='move'?'flex':'none';$('trackForm').reset();$('trackModal').classList.add('open')}
$('trackForm').onsubmit=e=>{e.preventDefault();let k=iso(selected);if(trackType==='sleep'){let v=+$('sleepHours').value;if(v<0||v>24)return;sleeps[k]=v}else{let v=+$('activityMinutes').value;if(v<=0)return;moves[k]=moves[k]||[];moves[k].push({type:$('activityType').value,minutes:v})}save();closeModal('trackModal');render();toast('Запись сохранена')};
function history(type){let k=iso(selected);if(type==='sleep')toast(sleeps[k]!=null?`Сон: ${sleeps[k]} ч`:'Сон пока не записан');else{let a=moves[k]||[];toast(a.length?a.map(x=>x.type+': '+x.minutes+' мин').join(' · '):'Активность пока не записана')}}
function closeModal(id){$(id).classList.remove('open')}document.querySelectorAll('.modal').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open')}));
function toast(s){$('toast').textContent=s;$('toast').classList.add('show');clearTimeout(window.tt);window.tt=setTimeout(()=>$('toast').classList.remove('show'),2300)}
$('date').value=iso(selected);render();
</script></body></html>
